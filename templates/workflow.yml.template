# .workflow.yml — repo-root config (stable lifecycle). Written by /bootstrap.
# All fields optional; defaults shown. Loader fails closed if this file is
# absent in an active workflow invocation (see ADR-001, ADR-005).

# spec_storage: specs/
#   Path (relative to repo root or absolute) where specs/ live. Must resolve
#   under $HOME or the repo root; no symlink ancestors; no '..' segments.

# gate_pool: knowledge-base/gates.yml
#   Location of the canonical gate registry.

# agent_pool: ~/.claude/agents
#   Directory containing agent definitions referenced by per-spec config.

# validate_scope: per-task
#   One of: per-task, per-spec, both. Governs when /validate runs gates.
#   See ADR-007.

# tiers:
#   Spec-tier ceiling thresholds and per-tier behavior. Drives flow shape
#   (spec.md/design.md/test-strategy.md skip rules, agent-gate skip on /validate,
#   /validate-impl skip, file/task ceilings checked at /implement step 0).
#   Defaults shown.
# tiers:
#   small:  { tasks: 5,  files: 10, agent_skip: [security, code-quality, architecture, compliance] }
#   medium: { tasks: 10, files: 30, agent_skip: [] }
#   large:  { tasks: null, files: null, agent_skip: [] }

# spec_storage_mode: repo
#   One of: repo, vault.
#   - repo  — specs/ live inside the same git repo as code. Single-repo flow.
#   - vault — specs/ live in a vault (e.g. master-brain Obsidian vault) and
#             each spec binds one or more code repos via repos[] in the
#             per-spec config.yml. Multi-repo flow.

# default_repos: []
#   Optional list of repo bindings prefilled by /bootstrap when
#   spec_storage_mode=vault. Each entry: { name: <id>, path: <abs|~>, role: <free> }.
#   Used as the default for repos[] on new specs; per-spec config.yml may
#   override or extend.
