# .workflow.yml — repo-root config (stable lifecycle). Written by /bootstrap.
# All fields optional; defaults shown. Loader fails closed if this file is
# absent in an active workflow invocation (see ADR-001, ADR-005).

# spec_storage: specs/
#   Path (relative to repo root or absolute) where specs/ live. Must resolve
#   under $HOME or the repo root; no symlink ancestors; no '..' segments.
#   May contain the literal token `{project}` (vault mode) — substituted with
#   the per-spec project segment, e.g. `projects/{project}/specs`. The project
#   name comes from per-spec config.yml `project:` or `--project` on first
#   /explore. Loader exits 4 if `{project}` is present but unresolved.

# gate_pool: []
#   Inline gate registry — the canonical list of deterministic gates for this
#   repo (ADR-0002). NOT a path; an array. Each entry:
#     - id:         ^[a-zA-Z0-9_-]{1,64}$  (unique within this file)
#       command:    string, <=256 chars
#       applies_to: list, each in {any, rust, typescript, javascript,
#                                  python, go, shell, markdown}
#       category:   one of {lint, test, security, format, build, docs}
#       blocking:   bool (default true)
#   Example:
#     gate_pool:
#       - { id: rust-clippy, command: "cargo clippy -- -D warnings",
#           applies_to: [rust], category: lint, blocking: true }
#       - { id: rust-test,   command: "cargo test --workspace",
#           applies_to: [rust], category: test, blocking: true }

# agent_pool: ~/.claude/agents
#   Directory containing agent definitions referenced by per-spec config.

# validate_scope: per-task
#   One of: per-task, per-spec, both. Governs when /validate runs gates.
#   See ADR-007.

# tiers:
#   Spec-tier ceiling thresholds and per-tier behavior. Drives flow shape
#   (spec.md/design.md/test-strategy.md skip rules, agent-gate skip on /validate,
#   /validate-impl skip, file/task ceilings checked at /implement step 0).
#   Defaults shown.
# tiers:
#   small:  { tasks: 5,  files: 10, agent_skip: [security, code-quality, architecture, compliance], impl_chunk_size: 0 }
#   medium: { tasks: 10, files: 30, agent_skip: [], impl_chunk_size: 3 }
#   large:  { tasks: null, files: null, agent_skip: [], impl_chunk_size: 3 }
#   impl_chunk_size — behavior-count budget K for chunked delegated /implement
#   (ADR-0018). Cuts a delegated task's settled backlog into ≤K-behavior
#   bounded-context chunks re-spawned on the same implementer. Per-spec
#   config.yml impl_chunk_size overrides the tier default. small NEVER chunks
#   (loader forces 0 = off regardless). 0 = chunking disabled.

# spec_storage_mode: repo
#   One of: repo, vault.
#   - repo  — specs/ live inside the same git repo as code. Single-repo flow.
#   - vault — specs/ live in a vault (e.g. master-brain Obsidian vault) and
#             each spec binds one or more code repos via repos[] in the
#             per-spec config.yml. Multi-repo flow.

# default_repos: []
#   Optional list of repo bindings prefilled by /bootstrap when
#   spec_storage_mode=vault. Each entry: { name: <id>, path: <abs|~>, role: <free> }.
#   Used as the default for repos[] on new specs; per-spec config.yml may
#   override or extend.

# --- Vault thin-pointer example (master-brain holds specs; gateless) ---
# A vault .workflow.yml owns ONLY workflow settings + general_kb_path. It
# carries NO gate_pool — gates live in each target code repo and resolve
# per-task from the spec's repos[]. (Exception: self-hosting — if a repos[]
# entry points at the vault dir itself, the vault MAY carry gate_pool.)
# There is a single KB now: $WF_GENERAL_KB (ADR-0002, single-KB model).
#
# spec_storage_mode: vault
# spec_storage: projects/{project}/specs
# general_kb_path: <YOUR_GENERAL_KB_PATH>   # e.g. ~/Desktop/projects/master-brain/general-knowledge-base
# validate_scope: per-task
# tiers:
#   small:  { tasks: 5,  files: 10, agent_skip: [security, code-quality, architecture, compliance], impl_chunk_size: 0 }
#   medium: { tasks: 10, files: 30, agent_skip: [], impl_chunk_size: 3 }
#   large:  { tasks: null, files: null, agent_skip: [], impl_chunk_size: 3 }   # null = unbounded
# default_repos:
#   - { name: app, path: ~/Desktop/projects/app, role: primary }
#
# --- Per-repo thin gate-pool file (vault mode) ---
# Each bound code repo gets its own thin .workflow.yml carrying ONLY a
# kind marker + gate_pool. The config loader's walk-up skips any
# .workflow.yml with this marker and keeps ascending to the real config.
# Created once per repo by `/bootstrap` (repo-gate-init).
#
# kind: repo-gate-pool
# gate_pool:
#   - { id: rust-clippy, command: "cargo clippy -- -D warnings",
#       applies_to: [rust], category: lint, blocking: true }
