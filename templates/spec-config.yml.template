# specs/<feature>/config.yml — per-spec config (ephemeral lifecycle).
# Produced by /explore step 0 (config-inferencer) and edited via /config.
# All fields optional; defaults shown.

# project: <name>
#   Vault mode only. The project segment this spec lives under when
#   .workflow.yml spec_storage contains the `{project}` token
#   (e.g. projects/{project}/specs). Must match ^[a-z0-9][a-z0-9_-]{0,31}$ and
#   the directory the config was discovered under (loader exit 4 on mismatch).
#   Written by /explore step 0 from the resolved --project value.

# tags: []
#   Free-form spec tags. Each matches ^[a-zA-Z0-9_-]{1,32}$.

# gates: []
#   Gate ceiling for this spec. Each id must exist in the bound repo's
#   `.workflow.yml gate_pool` (vault: union across repos[]; repo mode: the
#   repo's own .workflow.yml gate_pool).
#   /validate runs the intersection of these and the task's ground_rules
#   eligible set (ADR-003).

# agents:
#   explore: []
#   propose: []
#   implement: []
#   validate: []
#   pr-review: []
#   Fully-qualified agent ids (<category>/<name> or bare <name>). Each must
#   resolve under agent_pool. See design.md Agent ID grammar.

# validate_scope: per-task
#   Optional override of .workflow.yml validate_scope. ADR-007.

# tier: small | medium | large
#   Required. Inferred by config-inferencer at /explore step 0 (user-approved).
#   Drives flow shape: small skips spec.md/design.md/test-strategy.md/validate-spec
#   and skips Phase-2 agent gates + /validate-impl. medium skips design.md +
#   test-strategy.md + validate-spec. large = full flow.

# track: feature | technical
#   Optional, default `feature`. Inferred by config-inferencer at /explore
#   step 0 (user-approved) or forced via `/explore --technical`.
#   feature   = business-facing work; normal spec.md/design.md flow.
#   technical = refactor / decouple / tracing / deploy / tech-debt. NO
#               spec.md/design.md/test-strategy.md at any tier (tasks/ only);
#               rationale lives in docs/adr/ + CONTEXT.md (via /grill).
#               /grill is mandatory for medium/large technical specs
#               (/propose hard-refuses without docs/adr), optional for small.
#               Per-task technical_acceptance drives the TDD loop.

# branch_strategy: per-task | single-branch
#   Optional, default `per-task`. Inferred by config-inferencer at /explore
#   step 0 (user-approved).
#   per-task      = current behavior: integration branch feat/$FEATURE +
#                   per-task sub-branch feat/$FEATURE/<task> + per-task draft
#                   PR (base feat/$FEATURE).
#   single-branch = one feat/$FEATURE branch off main; no per-task sub-branch;
#                   commits accumulate; no per-task PR. One spec PR opened/
#                   readied at the final /ship (base main). For tightly-coupled
#                   refactors/spikes where per-task PR overhead is unwanted.
#                   TDD red/green/refactor commits preserved (no squash).

# tier_ceiling:
#   Optional per-spec override of .workflow.yml tiers.<tier> thresholds.
#   tasks: <int|null>
#   files: <int|null>

# repos: []
#   Multi-repo binding. Required when .workflow.yml spec_storage_mode=vault.
#   Each entry binds a logical name to a checked-out git repo. Tasks pick
#   one via the task-frontmatter `repo:` field. Loader expands `~`, validates
#   each path is a git working tree (loader exit 7 on failure).
#   Example:
#     repos:
#       - name: frontend
#         path: ~/Desktop/projects/foo-web
#         role: frontend
#       - name: backend
#         path: ~/Desktop/projects/foo-api
#         role: backend
#   Hard rule: one task = one repo. Cross-repo work splits into sibling tasks.
